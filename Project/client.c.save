        close(server_socket);
        exit(1);
    }*/

    /* Send username as first message */

    server_socket = connect_to_server();

    if (server_socket < 0) {
        printf("[SYSTEM]: Server not available. Please start server first.\n");
        exit(1);
    }

    Packet pkt = {0};
    strcpy(pkt.username, username);
    strcpy(pkt.message, "JOIN");
    pkt.type = 0;
    if (send(server_socket, &pkt, sizeof(pkt), 0) < 0) {
        perror("send join");
        close(server_socket);
        exit(1);
    }

    printf("[SYSTEM]: Connected to server as '%s'\n", username);

    pthread_t send_tid, recv_tid;
    pthread_create(&send_tid, NULL, send_thread, username);
    pthread_create(&recv_tid, NULL, receive_thread, NULL);

    pthread_join(send_tid, NULL);
    pthread_join(recv_tid, NULL);
    close(server_socket);
    return 0;
}
